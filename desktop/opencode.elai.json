{
  "$schema": "https://opencode.ai/config.json",
  "model": "elai/coder",
  "default_agent": "elai-coder",
  "providers": {
    "elai": {
      "name": "ELAI hub (desktop RTX 5090)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "__HUB_URL__"
      },
      "models": {
        "coder": {
          "modelID": "coder",
          "name": "Qwen3.8-27B (hub)",
          "family": "qwen",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "contextsaver": {
        "type": "local",
        "command": [
          "__CONTEXTSAVER_EXE__",
          "mcp"
        ],
        "timeout": {
          "startup": 60000
        }
      }
    }
  },
  "instructions": [
    "__RULES_FILE__"
  ],
  "agents": {
    "elai-coder": {
      "description": "ELAI coder on the desktop hub (Qwen3.8-27B); follows the ELAI rules file",
      "mode": "primary",
      "model": "elai/coder"
    }
  }
}
