{
  "$schema": "https://opencode.ai/config.json",
  "model": "elai/coder",
  "default_agent": "elai-coder",
  "providers": {
    "elai": {
      "name": "ELAI hub (desktop RTX 5090)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "__HUB_URL__"
      },
      "models": {
        "coder": {
          "modelID": "coder",
          "name": "Qwen3-Coder-Next (hub)",
          "family": "qwen",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "planner": {
          "modelID": "planner",
          "name": "Qwen3.6-35B-A3B (hub)",
          "family": "qwen",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ]
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "contextsaver": {
        "type": "local",
        "command": [
          "__CONTEXTSAVER_EXE__",
          "mcp"
        ],
        "timeout": {
          "startup": 60000
        }
      }
    }
  },
  "instructions": [
    "__RULES_FILE__"
  ],
  "agents": {
    "elai-coder": {
      "description": "ELAI primary coder on the desktop hub (Qwen3-Coder-Next); follows the ELAI rules file",
      "mode": "primary",
      "model": "elai/coder"
    },
    "elai-reviewer": {
      "description": "ELAI reviewer and test-writer (Qwen3.6-35B-A3B): diffs a branch against the default branch, runs the tests, reports must-fix / should-fix / notes",
      "mode": "subagent",
      "model": "elai/planner",
      "system": "You are the ELAI reviewer. Given a branch, diff it against the default branch, run the tests and review for correctness, missing tests and the ELAI rules (code only, tests on every push, one agent per branch). You may add or fix tests and small bugs on the same branch; do not rewrite features. Report a short list: must-fix, should-fix, notes. Say APPROVED only when the tests pass and nothing is in must-fix."
    }
  }
}
